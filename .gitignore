# ============================================================
# .gitignore — fuente única para todo el repo (raíz + backend)
# No usar .gitignore adicionales dentro de subcarpetas.
# ============================================================

# ── Variables de entorno / secretos ─────────────────────────
# Regla amplia: cualquier .env* queda ignorado por defecto.
# Los templates de ejemplo se des-ignoran explícitamente abajo.
.env
.env.*
!.env.example
!.env.production.example
!.env.local.example

# ── Dependencias ─────────────────────────────────────────────
node_modules/
bun.lock

# ── Builds / artefactos generados ───────────────────────────
dist/
dist-ssr/
.output/
.vinxi/
.tanstack/**
.nitro
*.local

# ── Generado automáticamente por el plugin de TanStack Router ──
# Se regenera solo en cada `npm run dev` / `npm run build`.
src/routeTree.gen.ts

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Datos persistentes / sensibles en runtime (NUNCA a git) ──
# Backups de base de datos generados por la app
/backups/
backend/backups/
# Adjuntos y logo subidos por usuarios
backend/uploads/
# Sesión de WhatsApp (Baileys) — es una credencial de sesión
backend/whatsapp-session/
whatsapp-session/
# Dumps SQL sueltos que alguien genere a mano en cualquier lugar
*.dump
*.sql.gz
*.bak

# ── Tests / QA ───────────────────────────────────────────────
coverage/
playwright-report/
test-results/

# ── Wrangler / Cloudflare (si se usa en algún momento) ───────
.wrangler/
.dev.vars

# ── Editor / sistema operativo ───────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Archivos temporales ──────────────────────────────────────
*.tmp
*.temp
*~
