# ============================================================
# Bitlogic Backend — Production Environment Example
# ============================================================
# IMPORTANTE: Copiar a .env.production y actualizar valores reales
# NEVER commit .env.production al repositorio
#
# cp .env.production.example .env.production
# # ... editar valores ...
# ============================================================

# ── Core Configuration ────────────────────────────────────
NODE_ENV=production
PORT=3001
CORS_ORIGIN=https://clientes.bitlogic.com.ar

# ── Database ──────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://bitlogic_user:STRONG_PASSWORD_CHANGE_ME@localhost:5432/bitlogic_prod

# ── JWT (JSON Web Tokens) ─────────────────────────────────
# IMPORTANTE: Generar claves aleatorias (min 32 caracteres)
# Comandos para generar:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your-random-32-char-secret-key-CHANGE-THIS-NOW
JWT_REFRESH_SECRET=your-random-32-char-refresh-key-CHANGE-THIS-NOW
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
JWT_REFRESH_EXPIRY_SHORT=1d

# ── SMTP Configuration (Email) ───────────────────────────
# Mailtrap (testing/development)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-mailtrap-inbox-id
SMTP_PASS=your-mailtrap-password

# SendGrid (production)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.your-sendgrid-api-key

SMTP_FROM_NAME=Bitlogic
SMTP_FROM_EMAIL=noreply@bitlogic.com.ar

# ── HestiaCP Integration ──────────────────────────────────
# IMPORTANTE: Obtener API key desde HestiaCP panel
# Panel → My Account → API Token
HESTIA_API_URL=https://panel.bitlogic.com.ar:8083
HESTIA_API_KEY=your-hestia-api-key-CHANGE-THIS-NOW
HESTIA_USERNAME=admin
HESTIA_PASSWORD=not-used-api-key-required
HESTIA_VERIFY_SSL=true

# ── Optional: AWS S3 (para backups) ───────────────────────
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret
# AWS_S3_BUCKET=bitlogic-backups

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json

# ── Security ──────────────────────────────────────────────
# Rate limiting
RATE_LIMIT_WINDOW_MS=900000    # 15 minutos
RATE_LIMIT_MAX_REQUESTS=100

# ════════════════════════════════════════════════════════════
# CHECKLIST ANTES DE DESPLEGAR:
# ════════════════════════════════════════════════════════════
# [ ] DATABASE_URL actualizado con credenciales reales
# [ ] JWT_ACCESS_SECRET generado y único
# [ ] JWT_REFRESH_SECRET generado y único
# [ ] SMTP configurado (Mailtrap o SendGrid)
# [ ] HESTIA_API_KEY actualizado
# [ ] CORS_ORIGIN es https:// (no http://)
# [ ] Archivo .env.production NO commitear al repo
# [ ] Permisos: chmod 600 .env.production
# ════════════════════════════════════════════════════════════
