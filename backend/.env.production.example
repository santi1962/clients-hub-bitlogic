# ============================================================
# Bitlogic Backend — Production Environment Example
# ============================================================
# IMPORTANTE: Copiar a .env y actualizar valores reales
# NUNCA commitear el .env real al repositorio
#
# cp .env.production.example .env
# # ... editar valores ...
# ============================================================

# ── Core ───────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# URL(s) del frontend permitidas por CORS (separadas por coma si hay más de una)
CORS_ORIGIN=https://clientes.bitlogic.com.ar
# URL del frontend, para links en emails y redirects post-pago de MercadoPago
FRONTEND_URL=https://clientes.bitlogic.com.ar
# URL pública del backend — requerida si MP_ACCESS_TOKEN está configurado
# (MercadoPago la usa para mandar el webhook de confirmación de pago)
BACKEND_PUBLIC_URL=https://api-clientes.bitlogic.com.ar

# ── Base de datos ────────────────────────────────────────────
DATABASE_URL=postgresql://bitlogic_user:STRONG_PASSWORD_CHANGE_ME@localhost:5432/bitlogic

# ── JWT ───────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your-random-secret-key-CHANGE-THIS-NOW
JWT_REFRESH_SECRET=your-random-refresh-key-CHANGE-THIS-NOW
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
JWT_REFRESH_EXPIRY_SHORT=1d

# ── SMTP (mailbox propia servida por HestiaCP) ────────────────
SMTP_HOST=mail.bitlogic.com.ar
SMTP_PORT=587
SMTP_USER=noreply@bitlogic.com.ar
SMTP_PASS=CHANGE_ME
SMTP_FROM_NAME=Bitlogic
SMTP_FROM_EMAIL=noreply@bitlogic.com.ar

# ── HestiaCP (solo lectura) ────────────────────────────────────
HESTIA_API_URL=https://panel.bitlogic.com.ar:8083
HESTIA_API_KEY=CHANGE_ME
HESTIA_VERIFY_SSL=true

# ── MercadoPago (opcional — dejar vacío si todavía no se usa) ──
MP_ACCESS_TOKEN=
# Sin esto, el webhook de pagos rechaza toda notificación (no acepta sin
# firma en producción bajo ninguna circunstancia). Tus integraciones > tu
# app > Webhooks > Configurar notificaciones > revelar clave secreta.
MP_WEBHOOK_SECRET=
MP_WEBHOOK_TOLERANCE_SECONDS=300

# ── Telegram (opcional — avisos de tickets al staff) ───────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── WhatsApp / Baileys (opcional — recordatorios de pago) ──────
WHATSAPP_ENABLED=false
WHATSAPP_SESSION_DIR=./whatsapp-session

# ── Logging ───────────────────────────────────────────────────
# error|warn|info|debug
LOG_LEVEL=info

# ── Scheduler (node-cron) ──────────────────────────────────────
# En producción, en true: corre hestia-sync (02:30), delinquency-detection
# (08:00) y payment-reminders (09:00) todos los días. La ejecución manual
# desde /admin/automatizaciones funciona siempre, esté esto en true o false.
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=America/Argentina/Buenos_Aires

# Overrides opcionales de horario (formato cron) — dejar comentado usa el
# horario de producción por defecto de cada job.
# SCHEDULE_HESTIA_SYNC=30 2 * * *
# SCHEDULE_DELINQUENCY_DETECTION=0 8 * * *
# SCHEDULE_PAYMENT_REMINDERS=0 9 * * *

# ════════════════════════════════════════════════════════════
# CHECKLIST ANTES DE DESPLEGAR:
# ════════════════════════════════════════════════════════════
# [ ] DATABASE_URL con credenciales reales
# [ ] JWT_ACCESS_SECRET / JWT_REFRESH_SECRET generados y únicos
# [ ] CORS_ORIGIN y FRONTEND_URL son https:// (no http://, no localhost)
# [ ] SMTP configurado con el mailbox real de Hestia
# [ ] HESTIA_API_KEY actualizado
# [ ] BACKEND_PUBLIC_URL configurado si se va a usar MercadoPago
# [ ] Este archivo (.env real) NO se commitea al repo
# [ ] Permisos restrictivos en el archivo .env (chmod 600)
# ════════════════════════════════════════════════════════════
