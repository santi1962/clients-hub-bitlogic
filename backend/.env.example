# ─────────────────────────────────────────
# Bitlogic Backend — Variables de entorno
# Copiar a .env y completar los valores
# ─────────────────────────────────────────

# Servidor
PORT=3001
NODE_ENV=development

# Base de datos — MariaDB es el único motor soportado. Dos formas
# equivalentes de configurarla, usar UNA sola:
#   1. DATABASE_URL=mysql://usuario:password@host:puerto/nombre_db
#   2. Variables discretas DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD
#      (más cómodas si la password tiene caracteres especiales, ya que no
#      hace falta URL-encodearla).
# postgresql:// ya no es un esquema soportado — la app aborta con un error
# claro si lo detecta.
DATABASE_URL=mysql://root:tu_password@localhost:3306/bitlogic
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=bitlogic
# DB_USER=root
# DB_PASSWORD=tu_password

# Variable SOLO para tests (no usar en desarrollo/producción): apunta a una
# MariaDB descartable para correr la suite de integración real
# (test/*-mariadb.test.js) contra un motor de verdad. Si no está seteada,
# esas pruebas se saltean sin fallar — ver docs/TESTING.md.
# MARIADB_TEST_URL=mysql://root:@127.0.0.1:13309/ignorado

# Bootstrap del primer super_admin (solo se leen al correr
# `npm run db:create-admin` — no hace falta dejarlas seteadas en el .env
# real, se pueden pasar inline en la misma línea de comando).
# ADMIN_NAME=Nombre Apellido
# ADMIN_EMAIL=admin@tu-dominio.com
# ADMIN_PASSWORD=una_password_de_al_menos_12_caracteres

# JWT — generá secretos seguros con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=cambiar_este_secreto_de_acceso_muy_largo
JWT_REFRESH_SECRET=cambiar_este_secreto_de_refresh_muy_largo

# Duración de tokens
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
JWT_REFRESH_EXPIRY_SHORT=1d

# CORS — URL del frontend en desarrollo
CORS_ORIGIN=http://localhost:5173

# SMTP — mailbox propia en tu dominio (servida por HestiaCP)
# 1. Hestia > Mail > tu-dominio.com > Add Account (ej. "noreply")
# 2. La contraseña que le pongas ahí va en SMTP_PASS
# 3. Confirmá el hostname del mail server en Hestia > Mail (normalmente mail.tu-dominio.com)
# 4. Verificá que DKIM/SPF estén activos en Hestia para que no caiga en spam
# En desarrollo local podés usar Mailtrap (https://mailtrap.io) para no mandar emails reales.
SMTP_HOST=mail.tu-dominio.com
SMTP_PORT=587
SMTP_USER=noreply@tu-dominio.com
SMTP_PASS=tu_password_del_buzon
SMTP_FROM_NAME=Bitlogic
SMTP_FROM_EMAIL=noreply@bitlogic.com.ar

# HestiaCP — Integración con panel de hosting (solo lectura)
# URL del panel: https://srv01.bitlogic.com.ar:8083
# Opción A (recomendada): API key — Hestia > My Account > API Token
HESTIA_API_URL=https://srv01.bitlogic.com.ar:8083
HESTIA_API_KEY=tu_api_key_de_hestia
# Opción B (si no usás API key): usuario/contraseña de la cuenta principal
# HESTIA_USERNAME=admin
# HESTIA_PASSWORD=tu_password_hestia
HESTIA_VERIFY_SSL=true

# Nivel de logging del backend (error|warn|info|debug). Default: info.
LOG_LEVEL=info

# MercadoPago — Pasarela de pagos
# Conseguí las credenciales en: https://www.mercadopago.com.ar/developers/panel/credentials
MP_ACCESS_TOKEN=APP_USR-tu_access_token_de_mercadopago
# URL pública del backend (necesaria para que MP envíe el webhook)
BACKEND_PUBLIC_URL=https://tu-dominio.com

# Clave secreta del webhook — Tus integraciones > tu app > Webhooks > "Configurar
# notificaciones" > revelar clave secreta. Sin esto, el webhook rechaza toda
# notificación (ver MP_WEBHOOK_ALLOW_UNSIGNED para probar en desarrollo).
MP_WEBHOOK_SECRET=
# Tolerancia (segundos) contra replay del timestamp del header x-signature.
MP_WEBHOOK_TOLERANCE_SECONDS=300
# SOLO desarrollo: si no tenés MP_WEBHOOK_SECRET todavía, permite probar el
# flujo de checkout/webhook sin verificar firma. Se ignora siempre en
# producción (NODE_ENV=production), sin importar este valor.
MP_WEBHOOK_ALLOW_UNSIGNED=false

# URL del frontend (para redirigir al cliente después del pago)
FRONTEND_URL=http://localhost:5173

# SSO: URL del backend de Bitiando (login único de staff). El hub reenvía la
# cookie `bitiando_session` a ${BITIANDO_API_URL}/api/auth/me para saber
# quién es — no toca su base de datos ni comparte JWT_SECRET.
BITIANDO_API_URL=http://localhost:4000

# Telegram — Notificaciones al staff (tickets nuevos, respuestas de clientes)
# 1. Hablale a @BotFather en Telegram, creá un bot con /newbot y copiá el token
# 2. Agregá el bot a tu chat/grupo y mandale un mensaje
# 3. Obtené tu chat_id: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp (Baileys) — Recordatorios de pago a clientes
# No requiere token: se vincula escaneando un QR desde WhatsApp (ver /admin/automatizaciones)
WHATSAPP_ENABLED=false
WHATSAPP_SESSION_DIR=./whatsapp-session

# Scheduler (node-cron) — automatiza hestia-sync, delinquency-detection y
# payment-reminders. Default: false en desarrollo, true en producción.
# La ejecución manual desde /admin/automatizaciones funciona siempre,
# esté habilitado o no este cron.
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=America/Argentina/Buenos_Aires

# Overrides opcionales de horario (formato cron). Dejar vacío/comentado usa
# el horario de producción por defecto. Útiles para probar sin esperar a
# la hora real (ej. "*/2 * * * *" = cada 2 minutos).
# SCHEDULE_HESTIA_SYNC=30 2 * * *
# SCHEDULE_DELINQUENCY_DETECTION=0 8 * * *
# SCHEDULE_PAYMENT_REMINDERS=0 9 * * *
