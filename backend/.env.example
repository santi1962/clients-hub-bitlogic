# ─────────────────────────────────────────
# Bitlogic Backend — Variables de entorno
# Copiar a .env y completar los valores
# ─────────────────────────────────────────

# Servidor
PORT=3001
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:tu_password@localhost:5432/bitlogic

# JWT — generá secretos seguros con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=cambiar_este_secreto_de_acceso_muy_largo
JWT_REFRESH_SECRET=cambiar_este_secreto_de_refresh_muy_largo

# Duración de tokens
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
JWT_REFRESH_EXPIRY_SHORT=1d

# CORS — URL del frontend en desarrollo
CORS_ORIGIN=http://localhost:5173

# SMTP — Configuración para envío de emails (usar Mailtrap en desarrollo)
# Registrate gratis en https://mailtrap.io para testear sin servidor SMTP real
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=tu_username_de_mailtrap
SMTP_PASS=tu_password_de_mailtrap
SMTP_FROM_NAME=Bitlogic
SMTP_FROM_EMAIL=noreply@bitlogic.com.ar

# HestiaCP — Integración con panel de hosting (solo lectura)
# URL del panel: https://srv01.bitlogic.com.ar:8083
# Usuario: admin (cuenta principal de Hestia)
# Contraseña: la misma que usas para loguear en Hestia
HESTIA_API_URL=https://srv01.bitlogic.com.ar:8083
HESTIA_USERNAME=admin
HESTIA_PASSWORD=tu_password_hestia
HESTIA_VERIFY_SSL=true
