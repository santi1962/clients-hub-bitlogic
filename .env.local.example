# ─────────────────────────────────────────────────────────────
# Frontend — variables de entorno locales
# Copiar este archivo a .env.local (no commitear)
# ─────────────────────────────────────────────────────────────

# URL del backend Express en desarrollo
VITE_API_BASE_URL=http://localhost:3001/api

# SSO: URL del FRONTEND de Bitiando (login único de staff). Si no hay sesión
# del hub ni de Bitiando, se redirige acá con ?next=<url del hub>.
VITE_BITIANDO_URL=http://localhost:3000
